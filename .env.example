# Load explicitly with Node --env-file=.env; never commit .env.
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_PATH=./data/journeycab.sqlite
PORT=3001
HOST=127.0.0.1
# Production: NODE_ENV=production and APP_ORIGIN=https://your-domain.example
# Enable only behind one trusted reverse proxy that replaces X-Forwarded-For.
TRUST_PROXY=0
# Production requests remain closed until launch checks are complete.
BOOKINGS_OPEN=false
# Optional SMS delivery. Without these, notifications remain pending for staff.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
